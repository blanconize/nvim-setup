# Shell integrations for the terminal-only workflow. Sourced from ~/.zshrc.

# Claude Code's native installer puts the binary here
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac

# Machine-local secrets (API keys, e.g. CONTEXT7_API_KEY for the Context7 MCP plugin).
# Never versioned: create with `chmod 600 ~/.zsh-secrets`.
[ -f "$HOME/.zsh-secrets" ] && source "$HOME/.zsh-secrets"

export EDITOR=nvim
export VISUAL=nvim
alias vim=nvim
alias vi=nvim

# fzf: Ctrl-R history, Ctrl-T files, Alt-C cd
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
  export FZF_DEFAULT_COMMAND='rg --files --hidden --glob "!.git" --glob "!node_modules"'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
fi

# zoxide: `z <fuzzy dir>` jumps to recently used directories
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# dev [-v|-h] <dir>: tmux session per project — nvim + claude in the first window,
# side by side on wide terminals, stacked (nvim on top) on portrait ones; -v / -h
# force stacked / side by side, Ctrl-a v flips later. 2nd window: a shell.
# Uses window/pane ids: name targets like "session:edit" misparse in tmux 3.7.
dev() {
  local layout=""
  case "$1" in
    -v) layout=main-horizontal; shift ;;
    -h) layout=main-vertical; shift ;;
  esac
  local dir="${1:-.}"
  dir="$(cd "$dir" 2>/dev/null && pwd)" || { echo "no such dir: $1"; return 1; }
  local name
  name="$(basename "$dir" | tr '.' '_')"
  if tmux has-session -t "=$name" 2>/dev/null; then
    tmux attach -t "=$name"
    return
  fi
  local cols="${COLUMNS:-$(tput cols)}" lines="${LINES:-$(tput lines)}"
  # Cells are about twice as tall as wide: fewer columns than 2x rows means portrait
  if [ -z "$layout" ]; then
    if (( cols < 2 * lines )); then layout=main-horizontal; else layout=main-vertical; fi
  fi
  local edit_win nvim_pane claude_pane
  read -r edit_win nvim_pane < <(tmux new-session -d -s "$name" -c "$dir" -n edit \
    -x "$cols" -y "$lines" -P -F '#{window_id} #{pane_id}')
  tmux send-keys -t "$nvim_pane" 'nvim' C-m
  claude_pane="$(tmux split-window -t "$nvim_pane" -c "$dir" -P -F '#{pane_id}')"
  tmux send-keys -t "$claude_pane" 'claude --ide' C-m
  tmux select-layout -t "$edit_win" "$layout"
  tmux new-window -d -t "=$name" -n shell -c "$dir"
  tmux select-window -t "$edit_win"
  tmux select-pane -t "$nvim_pane"
  [ -t 1 ] && tmux attach -t "=$name"
}

# claude: one session per repo. Warns when a session already runs in this
# directory, offers --continue when a previous one exists. `--ide` connects
# to the claudecode.nvim server so Claude sees the open buffer/selection.
claude() {
  local bin
  bin="$(whence -p claude)" || { echo "claude is not installed"; return 127; }
  if [ $# -eq 0 ]; then
    local running=0 pid
    for pid in $(pgrep -x claude); do
      lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | grep -q "^n${PWD}$" && running=$((running + 1))
    done
    if [ "$running" -gt 0 ]; then
      echo "⚠  $running Claude session(s) already running in $PWD (tmux: prefix+s to find them)"
      read -q "REPLY?Start another one anyway? [y/N] " || { echo; return 1; }
      echo
    fi
    local proj="$HOME/.claude/projects/$(printf '%s' "$PWD" | sed 's#[/.]#-#g')"
    if ls "$proj"/*.jsonl >/dev/null 2>&1; then
      read -q "REPLY?Continue the last session here? [y/N] " && { echo; "$bin" --ide --continue; return; }
      echo
    fi
    set -- --ide
  fi
  "$bin" "$@"
}
