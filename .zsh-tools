# Shell integrations for the terminal-only workflow. Sourced from ~/.zshrc.

export EDITOR=nvim
export VISUAL=nvim
alias vim=nvim
alias vi=nvim

# fzf: Ctrl-R history, Ctrl-T files, Alt-C cd
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
  export FZF_DEFAULT_COMMAND='rg --files --hidden --glob "!.git" --glob "!node_modules"'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
fi

# zoxide: `z <fuzzy dir>` jumps to recently used directories
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# dev <dir>: tmux session per project — nvim left, claude right, 2nd window shell
dev() {
  local dir="${1:-.}"
  dir="$(cd "$dir" 2>/dev/null && pwd)" || { echo "no such dir: $1"; return 1; }
  local name
  name="$(basename "$dir" | tr '.' '_')"
  if tmux has-session -t "$name" 2>/dev/null; then
    tmux attach -t "$name"
    return
  fi
  tmux new-session -d -s "$name" -c "$dir" -n edit
  tmux send-keys -t "$name:edit" 'nvim' C-m
  tmux split-window -h -t "$name:edit" -c "$dir" -l 45%
  tmux send-keys -t "$name:edit.2" 'claude' C-m
  tmux new-window -t "$name" -n shell -c "$dir"
  tmux select-window -t "$name:edit"
  tmux select-pane -t "$name:edit.1"
  tmux attach -t "$name"
}
