[user]
  name  = Matthias Weiss
  email = mw@bnize.com

[credential]
  helper = osxkeychain

[init]
  defaultBranch = main

[alias]
  a    = add
  all  = add -A
  st   = status -sb
  ci   = commit -m
  ca   = commit --amend
  br   = branch
  bd   = branch -D
  co   = checkout
  cb   = checkout -b
  df   = diff
  dfc  = diff --cached
  lg   = log --pretty=format:'%C(yellow)%h%Creset %Cgreen(%><(12)%cr%><|(12))%Creset - %s %C(blue)<%an>%Creset'
  pl   = pull
  ps   = push
  psf  = push --force-with-lease
  undo = reset --soft HEAD^
  f    = fetch
  sta  = stash
  stap = stash apply
  uall = reset .
  rbm  = pull --rebase origin main
  rbc  = rebase --continue
  rbs  = rebase --skip
  rba  = rebase --abort
  # Delete every local branch except main/master and the current one
  cln  = !git branch | grep -vE '^\\*|^\\s*(main|master)$' | xargs -r git branch -D

[color]
  diff   = auto
  status = auto
  branch = auto
  ui     = true

[core]
  excludesfile = ~/.gitignore_global
  editor       = vim
  whitespace   = cr-at-eol

[apply]
  whitespace = nowarn

[mergetool]
  keepBackup = false

[difftool]
  prompt = false

[help]
  autocorrect = 1

[pull]
  default = current
  rebase = true

[push]
  default = current
  autoSetupRemote = true

[commit]
  gpgsign = false

[diff]
  colorMoved = default
