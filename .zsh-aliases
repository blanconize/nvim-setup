# pnpm — the only package manager in our repos
alias p="pnpm"
alias pd="pnpm dev"
alias pt="pnpm test"
alias ptw="pnpm test:watch"
alias pl="pnpm lint"
alias ptc="pnpm typecheck"
alias pb="pnpm build"
alias pv="pnpm verify"

# Git
alias g="git"
alias lg="lazygit"

# Docker / Kubernetes
alias dc="docker compose"
alias k="kubectl"

# Playwright
alias cy="pnpm test:e2e"

# Utility
alias hg='history | grep'

# Kill a process on a specified port
kill_port() {
  if [ -n "$1" ]
  then
    lsof -ti :"$1" | xargs kill -9
  else
    echo "Pass in the port number."
  fi
}

# Customize how fzf handles certain commands
_fzf_comprun() {
  local command=$1
  shift

  case "$command" in
    cd)           fzf "$@" --preview 'tree -C {} | head -200' ;;
    *)            fzf "$@" ;;
  esac
}
